{
  "name": "@vvatikiotis/sandcastle-workflow",
  "version": "0.3.8",
  "description": "Packaged GitHub-native Sandcastle workflow",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sandcastle-workflow": "dist/cli.js",
    "sandcastle-workflow-setup": "dist/setup.sh"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "CONSUMER.md",
    "MAINTAINER.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:package",
    "test:unit": "tsx --test test/agent-run-status.test.js test/node-modules-overlay.test.js test/phase-diagnostics.test.js test/recovery-routing.test.js test/spec-selection.test.js test/verification-worktree-cleanup.test.js",
    "test:package": "FORCE_COLOR=0 node --test test/packed-cli.test.js",
    "test:docker": "tsx --test test/verification-worktree-cleanup.docker.js",
    "pack:artifact": "pnpm pack --pack-destination artifacts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "chalk": "~5.6.2",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
